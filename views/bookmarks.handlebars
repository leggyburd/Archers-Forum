<script src="/js/mainpage/feedRenderer.js"></script>
<header class="main-header">
  <div class="header-left">
    <a href="/mainpage" class="logo-link">
      <img class="nav-logo" src="/assets/logo_2.png" alt="Archer's Forum Logo" />
    </a>
    <a href="/profile" class="btn-admin-back" id="bookmarksBackLink">Back</a>
  </div>

  <div class="header-center">
    <h2 class="admin-title">My Bookmarks</h2>
  </div>

  <div class="header-right">
    <button class="btn-logout" id="bookmarksLogoutBtn" type="button">Logout</button>
  </div>
</header>

<main class="layout-container page-shell page-shell--bookmarks">
  <section></section>
  <section>
    <article class="content-card page-card page-card--bookmarks">
      <div class="page-card-head">
        <h3>Saved Posts</h3>
        <button class="btn-refresh-reports" id="refreshBookmarksBtn" type="button">Refresh</button>
      </div>

      <div id="bookmarkMsg" class="admin-msg" hidden></div>
      <div id="bookmarkPostsList" class="posts-feed"></div>
    </article>
  </section>
  <section></section>
</main>
